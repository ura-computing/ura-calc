use "@/core"
use "./src/lexer"
use "./src/parser"

fn calc(text String):
    io::out("========================================\n")
    io::out($"calculate expr:  {text}\nast:\n")
    p Parser
    p.toks = lex(text)
    root i32 = p.expr()
    io::out($"{p.label(root)}\n")
    n Node = p.nodes[root]
    if n.left >= 0:
        p.show(n.left, "", n.right < 0)
    if n.right >= 0:
        p.show(n.right, "", True)
    io::out($"result: {p.eval(root)}\n")

fn main() i32:
    line String = io::input()
    while not line.is_empty():
        try:
            calc(line)
        catch e Error:
            io::out($"error: {e.message}\n")
        line = io::input()
    io::out("========================================\n")
    return 0
